{
  "manifest_version": 3,
  "name": "RiftAtlas Replay",
  "version": "0.6.3.2",
  "description": "Records your RiftAtlas matches and replays them offline. Observes only - never sends, modifies, or delays a game action.",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "downloads",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "https://play.riftatlas.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "RiftAtlas Replay",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://play.riftatlas.com/*"
      ],
      "js": [
        "main-world/socket-observer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://play.riftatlas.com/*"
      ],
      "js": [
        "content/bridge.js",
        "content/notes-draft.js",
        "content/notes.js"
      ],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "player/player.html"
      ],
      "matches": [
        "https://play.riftatlas.com/*"
      ]
    }
  ]
}
